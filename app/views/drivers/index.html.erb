<!-- app/views/drivers/index.html.erb -->
<div class="flex flex-wrap items-center justify-between gap-4 mb-10">
  <h1 class="font-display text-3xl font-semibold tracking-tight text-text-primary">Drivers</h1>

  <select onchange="window.location.href = this.value"
          class="bg-bg-1 border border-line text-text-secondary text-[13px] rounded-md px-3 py-2 focus:outline-none">
    <% @years.each do |y| %>
      <option value="<%= drivers_season_path(year: y) %>" <%= "selected" if y == @year %>><%= y %></option>
    <% end %>
  </select>
</div>

<div class="max-h-[36rem] overflow-auto scroll-thin pr-5">
  <table class="w-full text-left whitespace-nowrap">
    <thead>
      <tr class="text-text-tertiary text-[11px] uppercase tracking-wide border-b border-line sticky top-0 z-20">
        <th class="py-3 pr-4 font-medium bg-bg-0" colspan="3"></th>
        <th class="py-3 pr-4 font-medium text-center bg-bg-0" colspan="6">Season Stats</th>
        <th class="py-3 pr-0 font-medium text-center bg-bg-0 border-l border-line" colspan="7">Lifetime Stats</th>
      </tr>
      <tr class="text-text-tertiary text-[11px] uppercase tracking-wide border-b border-line sticky top-[37px] z-10">
        <th class="py-3 pr-4 font-medium bg-bg-0">Flag</th>
        <th class="py-3 pr-4 font-medium bg-bg-0">#</th>
        <th class="py-3 pr-6 font-medium bg-bg-0">Name</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0">Points</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0">Wins</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0">Podiums</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0">Races Run</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0">Best Finish</th>
        <th class="py-3 pr-6 font-medium text-right bg-bg-0">DofD</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0 border-l border-line pl-4">Points</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0">Wins</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0">Podiums</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0">DofD</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0">Fastest Laps</th>
        <th class="py-3 pr-4 font-medium text-right bg-bg-0">Grand Slams</th>
        <th class="py-3 pr-0 font-medium text-right bg-bg-0">Poles</th>
      </tr>
    </thead>
    <tbody>
      <% @season_drivers.each do |sd| %>
        <% d = sd.driver %>
        <tr class="border-b border-line">
          <td class="py-4 pr-4 text-xl"><%= flag_emoji(d.nationality_country&.alpha2_code) %></td>
          <td class="py-4 pr-4 text-text-tertiary font-mono text-[15px]"><%= d.permanent_number %></td>
          <td class="py-4 pr-6">
            <div class="text-text-primary font-bold text-[15px]">
              <%= d.abbreviation %> – <%= d.name %>
            </div>
            <div class="text-text-tertiary text-[12px]"><%= @current_teams[d.id]&.name %></div>
          </td>
          <td class="py-4 pr-4 text-text-primary font-bold font-mono text-[14px] text-right"><%= number_with_precision(sd.total_points, precision: 2) %></td>
          <td class="py-4 pr-4 text-text-secondary font-mono text-[14px] text-right"><%= sd.total_race_wins %></td>
          <td class="py-4 pr-4 text-text-secondary font-mono text-[14px] text-right"><%= sd.total_podiums %></td>
          <td class="py-4 pr-4 text-text-secondary font-mono text-[14px] text-right"><%= sd.total_race_starts %></td>
          <td class="py-4 pr-4 text-text-secondary font-mono text-[14px] text-right"><%= sd.best_race_result || "—" %></td>
          <td class="py-4 pr-6 text-text-secondary font-mono text-[14px] text-right"><%= sd.total_driver_of_the_day %></td>
          <td class="py-4 pr-4 text-text-secondary font-mono text-[14px] text-right border-l border-line pl-4"><%= number_with_precision(d.total_points, precision: 2) %></td>
          <td class="py-4 pr-4 text-text-secondary font-mono text-[14px] text-right"><%= d.total_race_wins %></td>
          <td class="py-4 pr-4 text-text-secondary font-mono text-[14px] text-right"><%= d.total_podiums %></td>
          <td class="py-4 pr-4 text-text-secondary font-mono text-[14px] text-right"><%= d.total_driver_of_the_day %></td>
          <td class="py-4 pr-4 text-text-secondary font-mono text-[14px] text-right"><%= d.total_fastest_laps %></td>
          <td class="py-4 pr-4 text-text-secondary font-mono text-[14px] text-right"><%= d.total_grand_slams %></td>
          <td class="py-4 pr-0 text-text-secondary font-mono text-[14px] text-right"><%= d.total_pole_positions %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="flex items-center justify-between mb-10">
  <h1 class="font-display text-3xl font-semibold tracking-tight text-text-primary">Schedules</h1>
  <select onchange="window.location.href = this.value"
          class="bg-bg-1 border border-line text-text-secondary text-[13px] rounded-md px-3 py-2 focus:outline-none">
    <% @years.each do |y| %>
      <option value="<%= schedule_season_path(year: y) %>" <%= "selected" if y == @year %>><%= y %></option>
    <% end %>
  </select>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @races.each do |race| %>
    <% done = race.date < Date.current %>
    <% results = @top3[race.id] || [] %>

    <% card_content = capture do %>
      <div class="flex items-start justify-between mb-4">
        <span class="text-text-tertiary text-[12px] font-mono uppercase tracking-wide">Round <%= race.round %></span>
        <span class="text-text-tertiary text-[12px] font-mono"><%= race.date.strftime("%d %b") %></span>
      </div>

      <div class="min-h-[76px]">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xl leading-none"><%= flag_emoji(race.circuit.country&.alpha2_code) %></span>
          <h3 class="font-display font-bold text-lg text-text-primary"><%= race.circuit.country&.name || race.grand_prix.name %></h3>
        </div>
        <p class="text-text-tertiary text-[12px] uppercase tracking-wide line-clamp-2"><%= race.official_name %></p>
      </div>

      <% if done && results.present? %>
        <div class="space-y-2 pt-4 mt-4 border-t border-line">
          <% results.each do |r| %>
            <div class="flex items-center justify-between text-[13px]">
              <span class="text-text-primary font-bold"><%= r.position_number %>. <%= r.driver.name %></span>
              <span class="text-text-primary font-mono font-bold"><%= r.position_number == 1 ? r.time : r.gap %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="h-16 flex items-center justify-center text-text-tertiary text-[12px] mt-4">
          Track map coming soon
        </div>
      <% end %>
    <% end %>

    <% if done %>
      <%= link_to results_path(id: race.id), class: "block bg-bg-1 border border-line rounded-xl p-6 hover:border-text-tertiary transition-colors duration-150" do %>
        <%= card_content %>
      <% end %>
    <% else %>
      <div class="block bg-bg-1 border border-line rounded-xl p-6">
        <%= card_content %>
      </div>
    <% end %>
  <% end %>
</div>